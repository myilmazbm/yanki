          "deviceId": "5a3c9e2b-1f44-4c8a-9d21-7e6b0f1a2c33",
          "client": {
            "platform": "web",
            "appVersion": "0.1.0",
            "os": "windows",
            "locale": "tr-TR"
          }
        }
      }
    },
    {
      "dir": "s2c",
      "json": {
        "id": "…",
        "welcome": {
          "sessionId": "…",
          "userId": "…",
          "nodeId": "…",
          "serverTime": "…",
          "heartbeatIntervalMs": 25000,
          "serverVersion": "…"
        }
      }
    },
    {
      "dir": "server-action",
      "action": "drain"
    },
    {
