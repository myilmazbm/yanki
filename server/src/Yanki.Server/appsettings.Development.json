{
  "Yanki": {
    "Server": {
      "Urls": [ "https://localhost:8443" ],
      "DrainSeconds": 3,
      "Certificate": {
        "Source": "DevCert"
      }
    },
    "Database": {
      "ConnectionString": "Server=(localdb)\\MSSQLLocalDB;Database=yanki_dev;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False",
      "MigrateOnStartup": true
    },
    "Realtime": {
      "AllowDevTokens": true
    },
    "Logging": {
      "Directory": "%LOCALAPPDATA%\\Yanki\\logs",
      "RetainedFileCount": 3,
      "MinimumLevel": "Debug",
      "Console": true,
      "EventLog": false
    }
  }
}
