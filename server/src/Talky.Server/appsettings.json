{
  "Talky": {
    "Node": {
      "Roles": "all"
    },
    "Server": {
      "Urls": [ "https://+:8443" ],
      "AllowInsecureHttp": false,
      "DrainSeconds": 30,
      "KnownProxies": [],
      "Certificate": {
        "Source": "DevCert",
        "StoreName": "My",
        "StoreLocation": "LocalMachine"
      }
    },
    "Database": {
      "CommandTimeoutSeconds": 5,
      "MaxRetryCount": 3,
      "MigrateOnStartup": false
    },
    "Realtime": {
      "Path": "/ws",
      "HeartbeatIntervalMs": 25000,
      "HelloTimeoutMs": 5000,
      "MaxFrameBytes": 65536,
      "OutboundQueueCapacity": 256,
      "MaxConnectionsPerUser": 16,
      "AllowDevTokens": false
    },
    "Logging": {
      "Directory": "%ProgramData%\\Talky\\logs",
      "RetainedFileCount": 30,
      "MinimumLevel": "Information"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
