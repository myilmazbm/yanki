{
  "Talky": {
    "Node": {
      "Roles": "all"
    },
    "Server": {
      "Urls": [ "https://+:8443" ],
      "AllowInsecureHttp": false,
      "DrainSeconds": 30,
      "KnownProxies": [],
      "Certificate": {
        "Source": "DevCert",
        "StoreName": "My",
        "StoreLocation": "LocalMachine"
      }
    },
    "Logging": {
      "Directory": "%ProgramData%\\Talky\\logs",
      "RetainedFileCount": 30,
      "MinimumLevel": "Information"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
