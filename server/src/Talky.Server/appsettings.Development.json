{
  "Talky": {
    "Server": {
      "Urls": [ "https://localhost:8443" ],
      "DrainSeconds": 3,
      "Certificate": {
        "Source": "DevCert"
      }
    },
    "Logging": {
      "Directory": "%LOCALAPPDATA%\\Talky\\logs",
      "RetainedFileCount": 3,
      "MinimumLevel": "Debug",
      "Console": true,
      "EventLog": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
