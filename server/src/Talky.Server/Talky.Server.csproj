<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Production ships a single binary named talky.exe (Windows service + CLI). -->
    <AssemblyName>talky</AssemblyName>
    <RootNamespace>Talky.Server</RootNamespace>
    <!-- CA1515: the entry point type and the test-visible composition root must stay public. -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Talky.Core\Talky.Core.csproj" />
    <ProjectReference Include="..\Talky.Data\Talky.Data.csproj" />
    <ProjectReference Include="..\Talky.Realtime\Talky.Realtime.csproj" />
    <ProjectReference Include="..\Talky.Identity\Talky.Identity.csproj" />
    <ProjectReference Include="..\Talky.Media\Talky.Media.csproj" />
    <ProjectReference Include="..\Talky.Files\Talky.Files.csproj" />
    <ProjectReference Include="..\Talky.Search\Talky.Search.csproj" />
    <ProjectReference Include="..\Talky.Push\Talky.Push.csproj" />
    <ProjectReference Include="..\Talky.Federation\Talky.Federation.csproj" />
    <ProjectReference Include="..\Talky.Protocol\Talky.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.EventLog" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Talky.IntegrationTests" />
    <InternalsVisibleTo Include="Talky.UnitTests" />
  </ItemGroup>

</Project>
