<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Generated wire contracts (WebSocket frames, cluster mesh) from api/proto. Do not hand-edit generated code.</Description>
    <NoWarn>$(NoWarn);CS1591;CA1707;CA1711;CA1716;CA1720;CA1815;CA1822;CA2227;IDE0005;IDE0161;CS8981</NoWarn>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Core.Api" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="../../../api/proto/talky/v1/*.proto" ProtoRoot="../../../api/proto" GrpcServices="None" Link="proto/talky/v1/%(Filename)%(Extension)" />
    <Protobuf Include="../../../api/proto/talky/cluster/v1/*.proto" ProtoRoot="../../../api/proto" GrpcServices="Both" Link="proto/talky/cluster/v1/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
