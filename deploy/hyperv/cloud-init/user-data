#cloud-config
# Yanki media appliance - Ubuntu LTS + LiveKit SFU, seeded through cloud-init NoCloud.
#
# Fallback path for Spike A: used only if LiveKit on Windows Server fails the criteria in
# docs/livekit-windows-spike.md. The appliance is sealed - the customer never logs in for
# routine operation; it is rebuilt rather than patched by hand.
#
# New-MediaAppliance.ps1 substitutes the __PLACEHOLDER__ values before building the seed.

hostname: __HOSTNAME__
fqdn: __FQDN__
manage_etc_hosts: true

# No password login anywhere. Break-glass access is the SSH key of the platform team.
ssh_pwauth: false
disable_root: true
users:
  - name: yankiops
    gecos: Yanki platform team (break-glass)
    groups: [adm, sudo]
    shell: /bin/bash
    sudo: ['ALL=(ALL) NOPASSWD:ALL']
    lock_passwd: true
    ssh_authorized_keys:
      - __SSH_PUBLIC_KEY__

package_update: true
package_upgrade: true
packages:
  - chrony        # media timestamps and TURN credentials need a correct clock
  - curl
  - ca-certificates
  - unattended-upgrades
  - ufw

write_files:
  # LiveKit configuration - the same shape as deploy/livekit/livekit.yaml, with the ports
  # and lifecycle values the Yanki design fixed.
  - path: /etc/livekit/livekit.yaml
    permissions: '0640'
    owner: livekit:livekit
    defer: true
    content: |
      port: 7880
      rtc:
        udp_port: 7882
        tcp_port: 7881
        use_external_ip: false
        node_ip: __NODE_IP__
      turn:
        enabled: true
        domain: __TURN_DOMAIN__
        udp_port: 3478
        tls_port: 5349
        cert_file: /etc/livekit/turn-cert.pem
        key_file: /etc/livekit/turn-key.pem
      keys:
        __API_KEY__: __API_SECRET__
      webhook:
        api_key: __API_KEY__
        urls:
          - https://yanki.corp/internal/livekit/webhook
      room:
        empty_timeout: 60
        departure_timeout: 15
        auto_create: false
      logging:
        json: true
        level: info
        pion_level: error

  - path: /etc/systemd/system/livekit.service
    permissions: '0644'
    content: |
      [Unit]
      Description=LiveKit SFU (Yanki media node)
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=simple
      User=livekit
      Group=livekit
      ExecStart=/usr/local/bin/livekit-server --config /etc/livekit/livekit.yaml
      Restart=always
      RestartSec=5
      # Media threads must not be starved, and the SFU holds many sockets.
      LimitNOFILE=1048576
      Nice=-5
      # Hardening: the SFU only ever reads its own configuration.
      NoNewPrivileges=true
      ProtectSystem=strict
      ProtectHome=true
      PrivateTmp=true
      ReadWritePaths=/var/log/livekit
      AmbientCapabilities=CAP_NET_BIND_SERVICE

      [Install]
      WantedBy=multi-user.target

  # Same install script the Windows node uses in spirit: pinned version, checksum verified.
  - path: /usr/local/sbin/install-livekit.sh
    permissions: '0700'
    content: |
      #!/bin/bash
      set -euo pipefail
      VERSION="__LIVEKIT_VERSION__"
      ARCHIVE="livekit_${VERSION}_linux_amd64.tar.gz"
      BASE="https://github.com/livekit/livekit/releases/download/v${VERSION}"
      TMP="$(mktemp -d)"
      trap 'rm -rf "$TMP"' EXIT
      curl -fsSL -o "$TMP/$ARCHIVE" "$BASE/$ARCHIVE"
      curl -fsSL -o "$TMP/checksums.txt" "$BASE/checksums.txt"
      ( cd "$TMP" && grep " $ARCHIVE\$" checksums.txt | sha256sum -c - )
      tar -xzf "$TMP/$ARCHIVE" -C "$TMP"
      install -o root -g root -m 0755 "$TMP/livekit-server" /usr/local/bin/livekit-server
      /usr/local/bin/livekit-server --version

runcmd:
  - [ systemctl, enable, --now, chrony ]
  - [ useradd, --system, --home, /var/lib/livekit, --create-home, --shell, /usr/sbin/nologin, livekit ]
  - [ install, -d, -o, livekit, -g, livekit, -m, '0750', /var/log/livekit ]
  - [ install, -d, -o, livekit, -g, livekit, -m, '0750', /etc/livekit ]
  - [ /usr/local/sbin/install-livekit.sh ]
  # The TURN certificate and key are delivered out of band (the same PKI as yanki.corp).
  - [ systemctl, daemon-reload ]
  - [ systemctl, enable, --now, livekit ]
  # Only the media ports. Signalling (7880) is restricted to the Yanki API nodes, which
  # reverse-proxy it under https://yanki.corp/media/{node}/rtc.
  - [ ufw, default, deny, incoming ]
  - [ ufw, default, allow, outgoing ]
  - [ ufw, allow, 7882/udp ]
  - [ ufw, allow, 3478/udp ]
  - [ ufw, allow, 7881/tcp ]
  - [ ufw, allow, 5349/tcp ]
  - bash -c 'ufw allow from __API_NODE_CIDR__ to any port 7880 proto tcp'
  - bash -c 'ufw allow from __API_NODE_CIDR__ to any port 22 proto tcp'
  - [ ufw, --force, enable ]

power_state:
  mode: reboot
  message: Yanki media appliance provisioned
  timeout: 30
  condition: true
