{
  "//": "Talky node configuration template. Install-Talky.ps1 replaces every __TOKEN__ and writes the result to <DataDir>\\appsettings.json. The MSI ships this file unmodified; edit it (or re-run Install-Talky.ps1 -ConfigOnly) before starting the service. 'talky doctor' fails while any __TOKEN__ remains.",

  "Urls": "__URLS__",

  "ConnectionStrings": {
    "Talky": "__SQL_CONNECTION_STRING__"
  },

  "Talky": {
    "NodeId": "__NODE_ID__",
    "Roles": "__ROLES__",
    "DataDir": "__DATA_DIR__",

    "Tls": {
      "CertificateThumbprint": "__CERT_THUMBPRINT__",
      "StoreName": "My",
      "StoreLocation": "LocalMachine"
    },

    "Cluster": {
      "MeshPort": 9443,
      "Seeds": []
    },

    "Realtime": {
      "HeartbeatIntervalMs": 25000,
      "MaxFrameBytes": 65536,
      "DrainGraceSeconds": 30
    },

    "Media": {
      "LiveKit": {
        "ApiKey": "",
        "ApiSecret": "",
        "WebhookPath": "/internal/livekit/webhook",
        "Nodes": []
      }
    },

    "Files": {
      "ShareUnc": "",
      "ScanWithAmsi": true
    },

    "Search": {
      "IndexDir": "__DATA_DIR__\\index"
    },

    "Push": {
      "RelayUrl": ""
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "__DATA_DIR__\\logs\\talky-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "fileSizeLimitBytes": 268435456,
          "rollOnFileSizeLimit": true,
          "shared": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "EventLog",
        "Args": {
          "source": "Talky",
          "logName": "Application",
          "restrictedToMinimumLevel": "Warning"
        }
      }
    ]
  },

  "AllowedHosts": "*"
}
