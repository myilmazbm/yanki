{
  "//": "Talky node configuration template. Install-Talky.ps1 substitutes every placeholder (upper-case name between double underscores) and writes the result to <DataDir>\\appsettings.json; the service is started as `talky.exe --role <roles> --data-dir <DataDir>`, which loads this file. Keys follow docs/configuration.md (Talky:Node, Talky:Server, Talky:Database, Talky:Realtime, Talky:Logging). Sections marked reserved are read by later milestones and ignored today. 'talky doctor' fails while any placeholder remains.",

  "Talky": {
    "Node": {
      "Id": "__NODE_ID__",
      "Roles": "__ROLES__"
    },

    "Server": {
      "Urls": [__URLS__],
      "AllowInsecureHttp": false,
      "DrainSeconds": 30,
      "KnownProxies": [],
      "Certificate": {
        "Source": "Store",
        "StoreName": "My",
        "StoreLocation": "LocalMachine",
        "Thumbprint": "__CERT_THUMBPRINT__"
      }
    },

    "Database": {
      "ConnectionString": "__SQL_CONNECTION_STRING__",
      "CommandTimeoutSeconds": 5,
      "MaxRetryCount": 3,
      "MigrateOnStartup": false
    },

    "Realtime": {
      "Path": "/ws",
      "HeartbeatIntervalMs": 25000,
      "HelloTimeoutMs": 5000,
      "MaxFrameBytes": 65536,
      "OutboundQueueCapacity": 256,
      "MaxConnectionsPerUser": 16,
      "AllowDevTokens": false
    },

    "Logging": {
      "Directory": "__DATA_DIR__\\logs",
      "RetainedFileCount": 30,
      "MinimumLevel": "Information",
      "Console": false,
      "EventLog": true
    },

    "Cluster": {
      "//": "reserved for M2 (gRPC mesh)",
      "MeshPort": 9443,
      "Seeds": []
    },

    "Files": {
      "//": "reserved for M4 (SMB/DFS blob store, AMSI scan)",
      "ShareUnc": "",
      "ScanWithAmsi": true
    },

    "Search": {
      "//": "reserved for M3 (embedded Lucene.NET index)",
      "IndexDirectory": "__DATA_DIR__\\index"
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
