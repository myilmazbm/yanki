{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "gen": {
      "inputs": ["../../../api/proto/**/*.proto", "buf.gen.yaml"],
      "outputs": ["src/gen/**"]
    },
    "typecheck": {
      "dependsOn": ["^gen", "gen", "^typecheck"]
    },
    "lint": {
      "dependsOn": ["^gen", "gen"]
    },
    "test": {
      "dependsOn": ["^gen", "gen"]
    },
    "build": {
      "dependsOn": ["^build", "gen"],
      "outputs": ["dist/**"]
    },
    "size": {
      "dependsOn": ["^gen", "gen"],
      "outputs": []
    }
  }
}
