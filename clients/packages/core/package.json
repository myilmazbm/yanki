{
  "name": "@yanki/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Platform-agnostic Yanki client core: realtime WebSocket client, storage/platform seams.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.src.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "size": "node scripts/measure-size.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.1",
    "@yanki/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@yanki/config": "workspace:*",
    "@yanki/test-utils": "workspace:*",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
