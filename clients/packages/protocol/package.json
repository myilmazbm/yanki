{
  "name": "@talky/protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Generated TypeScript wire contracts from api/proto. Do not hand-edit src/gen.",
  "exports": {
    ".": "./src/index.ts",
    "./v1": "./src/gen/talky/v1/frames_pb.ts"
  },
  "scripts": {
    "gen": "buf generate ../../../api/proto --path ../../../api/proto/talky/v1",
    "lint:proto": "buf lint ../../../api/proto",
    "breaking:proto": "buf breaking ../../../api/proto --against ../../../.git#branch=main,subdir=api/proto",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.72.0",
    "@bufbuild/protoc-gen-es": "^2.14.1"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.1"
  }
}
